---
import Layout from "../layouts/Layout.astro";
import PoolDiagram from "../components/PoolDiagram.astro";
import Brand from "../components/Brand.astro";
import { url } from "../lib/paths";
---

<Layout title="WeCoLab · Your hardware. Many sites. One cloud.">
  <section class="hero container">
    <div class="hero-copy">
      <div class="hero-label">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="eyebrow">A cooperative, multi-site cloud</span>
      </div>
      <h1>
        Your hardware.
        <br />Many sites.
        <br />
        <span>One cloud.</span>
      </h1>
      <p class="hero-description">
        Run your apps across the machines you and your collaborators already own:
        homelabs, offices, a small business's server room. Keep a standby at another
        site, back up to storage nobody can delete, and keep control of every site.
      </p>
      <div class="hero-actions">
        <a class="button" href={url("docs/get-started/")}>
          Get started <span aria-hidden="true">↗</span>
        </a>
        <a class="hero-github" href="https://github.com/WeCoLabHQ/wecolab">
          Explore the code <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="hero-note">
        <span class="small-mark" aria-hidden="true">
          ↳
        </span>{" "}
        Open source. AGPLv3. Built for people you trust.
      </p>
    </div>
    <div class="hero-visual">
      <PoolDiagram />
    </div>
  </section>
  <div class="stack-strip container">
    <span class="eyebrow">Good tools, working together</span>
    <div>
      <span>k3s</span>
      <span>Nebula</span>
      <span>Forgejo</span>
      <span>Flux</span>
      <span>CloudNativePG</span>
    </div>
    <a href={url("docs/architecture/")} aria-label="Explore the architecture">
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <section class="origin container" id="why-wecolab">
    <div>
      <span class="eyebrow section-label">01 / Why we started</span>
      <h2>
        There was room
        <br />
        in both our labs.
      </h2>
    </div>
    <div class="origin-copy">
      <p>
        WeCoLab started with two friends. One had spare compute the other could
        use. The other had resources to share back. Neither wanted to hand over
        their whole lab just to help the other out.
      </p>
      <p>
        We wanted the ease of a cloud platform, using the capacity we already
        had. A place to say <em>“you can use this much”</em> and get back to
        building.
      </p>
      <a class="text-link" href={url("comparisons/")}>
        The idea, and where it fits <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="how-section" id="how-it-works">
    <div class="container how-grid">
      <div class="how-intro">
        <span class="eyebrow section-label">02 / How it works</span>
        <h2>
          Share a slice.
          <br />
          Keep your site.
        </h2>
        <p>
          Each person's site stays its own Kubernetes cluster. WeCoLab gives you
          a shared way to offer capacity and deploy across them.
        </p>
        <div class="offer-ticket">
          <div>
            <span class="eyebrow">A capacity offer</span>
            <span class="ticket-corner" aria-hidden="true">
              ↗
            </span>
          </div>
          <dl>
            <div>
              <dt>From</dt>
              <dd>your site</dd>
            </div>
            <div>
              <dt>To</dt>
              <dd>a collaborator's project</dd>
            </div>
            <div>
              <dt>Resources</dt>
              <dd>4 CPU · 8 GiB · 40 GiB</dd>
            </div>
            <div>
              <dt>Workload</dt>
              <dd>Always-on server</dd>
            </div>
          </dl>
          <span class="ticket-caption">
            Example allocation, chosen by the owner
          </span>
        </div>
      </div>
      <ol class="how-steps">
        <li>
          <span class="step-number">01</span>
          <div>
            <h3>Bring your machines.</h3>
            <p>
              Start a fabric on a public Linux box. Invite a collaborator's site, add
              your own nodes, or join a Mac through a small Linux VM.
            </p>
            <a href={url("docs/install/")}>
              See what you need <span aria-hidden="true">↗</span>
            </a>
          </div>
        </li>
        <li>
          <span class="step-number">02</span>
          <div>
            <h3>Decide what to share.</h3>
            <p>
              Choose the boxes, CPU, memory and storage to offer, and the
              projects that can use them. Pools let several sites contribute to
              the same group.
            </p>
            <a href={url("docs/glossary/")}>
              Get to know offers & pools <span aria-hidden="true">↗</span>
            </a>
          </div>
        </li>
        <li>
          <span class="step-number">03</span>
          <div>
            <h3>Put that capacity to work.</h3>
            <p>
              Deploy a container or catalog app through the Console. Choose
              where it runs. For PostgreSQL-backed apps, add a standby at
              another site and archive to an external vault.
            </p>
            <a href={url("docs/console/")}>
              Take a tour of the Console <span aria-hidden="true">↗</span>
            </a>
          </div>
        </li>
      </ol>
      <figure class="console-shot">
        <img
          src={url("images/console-sites.png")}
          alt="The Console's Sites page: a public writer site and two others, their boxes and the offers between them"
          width="1440"
          height="900"
          loading="lazy"
        />
        <figcaption>
          The Console of a fabric with three sites. Names and addresses are examples.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="idle-section container" id="spare-capacity">
    <div class="idle-heading">
      <div>
        <span class="eyebrow section-label">
          03 / More than the server rack
        </span>
        <h2>
          Your spare Mac
          <br />
          has something to give.
        </h2>
      </div>
      <p>
        Set a base allocation for the Linux VM, then let it use more when you're
        away. Eligible best-effort apps run while the Mac is idle, and give way
        when you return.
      </p>
    </div>
    <div class="idle-panel" id="idle-demo">
      <div class="idle-screen">
        <div class="panel-caption">
          <span class="eyebrow">WeCoLab for Mac</span>
          <span class="tag">Interactive illustration</span>
        </div>
        <div class="laptop-art" aria-hidden="true">
          <div class="laptop-display">
            <Brand size={58} />
            <span class="laptop-mode">You're at your desk</span>
            <div class="activity-lines">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
          <div class="laptop-base"></div>
        </div>
        <div
          class="mode-controls"
          role="group"
          aria-label="Illustrate Mac activity"
        >
          <button type="button" data-mode="active" aria-pressed="true">
            At your desk
          </button>
          <button type="button" data-mode="idle" aria-pressed="false">
            Away for a while
          </button>
        </div>
      </div>
      <div class="idle-details">
        <span class="eyebrow">You choose the contribution</span>
        <div class="capacity-row">
          <span>
            VM CPUs <small>(fixed at start)</small>
          </span>
          <strong>
            6<small> cores</small>
          </strong>
        </div>
        <div class="capacity-row priority-row">
          <span>Process priority</span>
          <span data-priority>Background</span>
        </div>
        <div class="capacity-meter cpu-meter" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </div>
        <div class="capacity-row">
          <span>VM memory target</span>
          <strong>
            <span data-memory>4</span>
            <small> / 12 GiB</small>
          </strong>
        </div>
        <div class="capacity-meter" aria-hidden="true">
          <i></i>
          <i></i>
          <i class="extra"></i>
          <i class="extra"></i>
          <i class="extra"></i>
          <i class="extra"></i>
        </div>
        <div class="mode-explanation" aria-live="polite">
          <span class="demo-dot" aria-hidden="true"></span>
          <p data-mode-description>
            New app work stays off this Mac. Running best-effort apps have up to
            a minute before eviction.
          </p>
        </div>
        <p class="idle-small">
          Example profiles, not live metrics: 2 base CPUs, 6 idle CPUs. The VM
          keeps 6 CPUs; with extra CPUs configured, the whole VM runs at
          background priority while you're active.
        </p>
        <a href={url("docs/mac/")} class="idle-link">
          Read the Mac guide <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="idle-footnote">
      <span>Always-on sites for persistent services.</span>
      <span>Idle laptops for work that can be interrupted.</span>
    </div>
  </section>

  <section class="trust-section container" id="trust">
    <div class="trust-title">
      <span class="eyebrow section-label">04 / Trust has a boundary</span>
      <h2>
        Collaborators share
        <br />
        resources.
        <br />
        <span>Not their whole network.</span>
      </h2>
      <p>
        Secure sharing takes more than a VPN. WeCoLab combines private
        connectivity with project permissions, workload policies and resource
        quotas.
      </p>
      <a href={url("docs/security/")} class="text-link">
        Read the security model <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="trust-details">
      <div>
        <span class="trust-icon" aria-hidden="true">
          ↔
        </span>
        <h3>Two meshes, two jobs.</h3>
        <p>
          Nebula connects the boxes. NetBird connects people to app front doors.
          A collaborator's laptop doesn't need access to your Kubernetes API.
        </p>
      </div>
      <div>
        <span class="trust-icon" aria-hidden="true">
          ⊞
        </span>
        <h3>Explicit permission to use capacity.</h3>
        <p>
          Projects can deploy at sites they own or hold an offer at. The site's
          Kubernetes policies enforce requested-resource quotas and workload
          boundaries.
        </p>
      </div>
      <div class="trust-caveat">
        <span class="eyebrow">Know who you're trusting</span>
        <p>
          The owner of a host can read data placed on it. Stewards hold the
          fabric's keys. Containers share a kernel. This is built for trusted
          peers, not anonymous tenants.
        </p>
      </div>
    </div>
  </section>

  <section class="fabric-section">
    <div class="container fabric-grid">
      <div class="git-illustration" aria-hidden="true">
        <div class="git-title">
          <span class="eyebrow">The fabric is a Git repository</span>
          <span>↓</span>
        </div>
        <div class="git-commit">
          <span class="commit-node"></span>
          <code>offer: share spare capacity</code>
        </div>
        <div class="git-split">
          <div>
            <span class="git-site">YOUR SITE</span>
            <code>
              Forgejo → Flux
              <br />↓<br />
              Local workloads
            </code>
          </div>
          <span class="git-link">↔</span>
          <div>
            <span class="git-site">THEIR SITE</span>
            <code>
              Forgejo → Flux
              <br />↓<br />
              Local workloads
            </code>
          </div>
        </div>
        <span class="git-caption">
          A full copy at every site. One writer at a time.
        </span>
      </div>
      <div class="fabric-copy">
        <span class="eyebrow section-label">05 / Made to stay yours</span>
        <h2>
          A shared plan.
          <br />
          Independent sites.
        </h2>
        <p>
          Every Console change is a Git commit. Every site holds a copy and
          applies its own part. An isolated site keeps running its existing
          workloads instead of waiting for a central hub.
        </p>
        <p>
          Stewards can take over as writer. Public access still depends on your
          entrances, and moves between database primaries need an operator. The
          boundaries matter as much as the design.
        </p>
        <a href={url("docs/architecture/")} class="text-link">
          Look under the hood <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="build-section container">
    <div class="build-top">
      <span class="eyebrow section-label">06 / Come build with us</span>
      <span class="tag">
        <span class="status-dot" aria-hidden="true"></span> Active development
      </span>
    </div>
    <div class="build-copy">
      <h2>
        This is the cloud
        <br />
        we want to share.
      </h2>
      <div>
        <p>
          WeCoLab has real code, a working model, and plenty still to prove.
          We're looking for homelabbers, small teams and operators who will try it, tell us where it
          breaks, and help make sharing easier.
        </p>
        <div class="build-actions">
          <a class="button" href={url("contribute/")}>
            Find your way in <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="https://github.com/WeCoLabHQ/wecolab">
            View the source ↗
          </a>
        </div>
      </div>
    </div>
    <div class="work-list">
      <a href={url("docs/development/")}>
        <span>Try it</span>
        <strong>A whole fabric on one laptop</strong>
        <span aria-hidden="true">↗</span>
      </a>
      <a href={url("contribute/")}>
        <span>Improve it</span>
        <strong>Mac lifecycle, recovery & app recipes</strong>
        <span aria-hidden="true">↗</span>
      </a>
      <a href={url("docs/")}>
        <span>Understand it</span>
        <strong>The decisions, the code, the limits</strong>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="development-note">
      Early software for hands-on operators. Start with non-critical workloads.
      Hardware, power, connectivity and backup storage still have costs; WeCoLab
      does not provide a managed-cloud SLA.
    </p>
  </section>
</Layout>
<script>
  const demo = document.querySelector<HTMLElement>("#idle-demo");
  if (demo) {
    const buttons = demo.querySelectorAll<HTMLButtonElement>("[data-mode]");
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const idle = button.dataset.mode === "idle";
        demo.classList.toggle("is-idle", idle);
        buttons.forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button)),
        );
        demo.querySelector("[data-priority]")!.textContent = idle
          ? "Normal"
          : "Background";
        demo.querySelector("[data-memory]")!.textContent = idle ? "12" : "4";
        demo.querySelector(".laptop-mode")!.textContent = idle
          ? "A little more room to share"
          : "You're at your desk";
        demo.querySelector("[data-mode-description]")!.textContent = idle
          ? "Eligible best-effort apps can use this Mac while you’re away. Databases stay on always-on sites."
          : "New app work stays off this Mac. Running best-effort apps have up to a minute before eviction.";
      }),
    );
  }
</script>
<style>
  .priority-row {
    margin-top: 12px;
    font-size: 12px;
    color: #c4d9c5;
  }
  [data-priority] {
    font-family: var(--mono);
  }
  .hero {
    display: grid;
    grid-template-columns: 1.04fr 1fr;
    gap: 55px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 67px;
  }
  .hero-label {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 25px;
  }
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hero-label .eyebrow {
    font-size: 10px;
    letter-spacing: 0.07em;
  }
  .hero h1 {
    font-size: clamp(60px, 6.15vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.065em;
  }
  .hero h1 > span {
    color: var(--accent);
  }
  .hero-description {
    font-size: 17px;
    line-height: 1.75;
    max-width: 440px;
    margin-top: 25px;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-top: 31px;
  }
  .hero-github {
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
  }
  .hero-github span {
    margin-left: 5px;
  }
  .hero-note {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    margin-top: 20px;
    display: flex;
    gap: 8px;
  }
  .small-mark {
    color: var(--accent);
  }
  .hero-visual {
    padding-top: 12px;
    animation: enter 0.7s ease both;
  }
  .hero-copy {
    animation: enter 0.5s ease both;
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .stack-strip {
    display: flex;
    align-items: center;
    border-block: 1px solid var(--line);
    padding-block: 24px;
    gap: 36px;
  }
  .stack-strip > .eyebrow {
    font-size: 10px;
    max-width: 130px;
    color: var(--muted);
  }
  .stack-strip > div {
    display: flex;
    justify-content: space-evenly;
    gap: 32px;
    flex: 1;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: #576a5e;
    font-size: 18px;
  }
  .stack-strip > a {
    font-size: 23px;
    text-decoration: none;
    width: 35px;
    text-align: right;
  }
  .section-label {
    color: var(--accent);
    margin-bottom: 23px;
  }
  .origin {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    padding-block: 91px 94px;
  }
  .origin h2 {
    font-size: 46px;
  }
  .origin-copy {
    padding-top: 4px;
    font-size: 18px;
    color: var(--muted);
  }
  .origin-copy p + p {
    margin-top: 18px;
  }
  .origin-copy .text-link {
    margin-top: 24px;
    font-size: 13px;
    color: var(--ink);
  }
  .origin-copy em {
    font-style: normal;
    color: var(--ink);
  }
  .console-shot {
    grid-column: 1 / -1;
    margin: 2rem 0 0;
  }

  .console-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.25);
  }

  .console-shot figcaption {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .how-section {
    background: #e9eee5;
    border-block: 1px solid var(--line);
    padding-block: 80px;
  }
  .how-grid {
    display: grid;
    grid-template-columns: 1fr 1.12fr;
    gap: 115px;
  }
  .how-intro > p {
    margin-top: 23px;
    color: var(--muted);
    font-size: 16px;
    max-width: 360px;
  }
  .offer-ticket {
    margin-top: 32px;
    background: #f7f8f2;
    border: 1px solid #c7d2c1;
    border-radius: 4px;
    padding: 19px 23px 14px;
    max-width: 369px;
    position: relative;
    box-shadow: 4px 4px 0 #dce4d5;
  }
  .offer-ticket > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .offer-ticket .eyebrow {
    font-size: 9px;
  }
  .ticket-corner {
    color: var(--accent);
  }
  .offer-ticket dl {
    margin-block: 13px;
  }
  .offer-ticket dl > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px dashed #d5decf;
    padding-block: 9px;
    font-size: 11px;
  }
  .offer-ticket dt {
    color: var(--muted);
  }
  .offer-ticket dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 10px;
    text-align: right;
  }
  .ticket-caption {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .how-steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .how-steps li {
    display: flex;
    gap: 24px;
    padding: 25px 0;
    border-bottom: 1px solid #ccd6c5;
  }
  .how-steps li:first-child {
    padding-top: 4px;
  }
  .how-steps li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .step-number {
    font: 10px var(--mono);
    color: var(--accent);
    padding-top: 7px;
  }
  .how-steps h3 {
    font-size: 25px;
  }
  .how-steps p {
    font-size: 15px;
    color: var(--muted);
    margin-top: 12px;
    line-height: 1.8;
  }
  .how-steps a {
    display: inline-block;
    font-size: 14px;
    margin-top: 13px;
    text-decoration: none;
    font-weight: 500;
  }
  .how-steps a span {
    margin-left: 9px;
  }
  .idle-section {
    padding-block: 90px;
  }
  .idle-heading {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 39px;
  }
  .idle-heading > p {
    font-size: 16px;
    color: var(--muted);
    max-width: 390px;
  }
  .idle-panel {
    background: var(--dark);
    color: #e9f3e5;
    border: 1px solid #17352c;
    border-radius: 7px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    overflow: hidden;
    --paper: #183c35;
  }
  .idle-screen {
    padding: 27px 30px 30px;
    border-right: 1px solid #3b5b49;
    background-image: radial-gradient(#456248 0.7px, transparent 0.7px);
    background-size: 18px 18px;
  }
  .panel-caption {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .panel-caption .eyebrow {
    font-size: 10px;
    color: #bbd6c3;
  }
  .panel-caption .tag {
    font-size: 10px;
    border-color: #54755e;
    color: #c0d6c5;
  }
  .laptop-art {
    width: 270px;
    margin: 30px auto 29px;
  }
  .laptop-display {
    border: 2px solid #678775;
    border-radius: 8px 8px 0 0;
    height: 173px;
    background: #132f29;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 22px;
    color: #7acfaf;
    position: relative;
