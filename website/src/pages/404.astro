---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/paths";
---

<Layout
  title="Page not found · WeCoLab"
  description="Find your way back to WeCoLab and its documentation."
>
  <section class="container missing-page">
    <span class="eyebrow">404 / Page not found</span>
    <h1>This page isn't here.</h1>
    <p>
      The link may be out of date. Head home, or search the documentation for
      what you need.
    </p>
    <div>
      <a class="button" href={url()}>
        Back to WeCoLab ↗
      </a>
      <a class="button button-secondary" href={url("docs/search/")}>
        Search documentation
      </a>
    </div>
  </section>
</Layout>
<style>
  .missing-page {
    padding-block: 100px 130px;
  }
  .eyebrow {
    color: var(--accent);
    margin-bottom: 24px;
  }
  p {
    font-size: 19px;
    max-width: 610px;
    color: var(--muted);
    margin-top: 24px;
  }
  .missing-page > div {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 32px;
  }
</style>
