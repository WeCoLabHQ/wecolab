---
import Brand from "../components/Brand.astro";
import { url } from "../lib/paths";
import "../styles/global.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
const {
  title,
  description = "A cooperative cloud built from the computers you and your collaborators already own. Share spare capacity, run your apps, and keep control of your lab.",
} = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header" data-pagefind-ignore>
      <div class="container header-inner">
        <a class="brand" href={url()} aria-label="WeCoLab home">
          <Brand />
          <span>
            WeCoLab<span class="brand-dot">.</span>
          </span>
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="main-navigation"
        >
          Menu <span aria-hidden="true">+</span>
        </button>
        <nav
          id="main-navigation"
          class="header-links"
          aria-label="Main navigation"
        >
          <a href={url("#how-it-works")}>How it works</a>
          <a
            href={url("docs/")}
            aria-current={path.includes("/docs/") ? "page" : undefined}
          >
            Documentation
          </a>
          <a
            href={url("contribute/")}
            aria-current={path.includes("/contribute/") ? "page" : undefined}
          >
            Get involved
          </a>
          <a
            class="nav-search"
            href={url("docs/search/")}
            aria-label="Search documentation"
          >
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="m16 16 4 4" />
            </svg>
            <span class="nav-search-label">Search docs</span>
            <kbd>⌘ K</kbd>
          </a>
          <a class="nav-source" href="https://github.com/WeCoLabHQ/wecolab">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="container footer-grid">
        <div>
          <a class="brand" href={url()}>
            <Brand size={30} />
            <span>
              WeCoLab<span class="brand-dot">.</span>
            </span>
          </a>
          <p>
            A little spare capacity.
            <br />A lot we can do together.
          </p>
        </div>
        <div class="footer-nav">
          <span class="eyebrow">Explore</span>
          <a href={url("docs/get-started/")}>Get started</a>
          <a href={url("docs/mac/")}>WeCoLab for Mac</a>
          <a href={url("comparisons/")}>Where we fit</a>
        </div>
        <div class="footer-nav">
          <span class="eyebrow">Understand</span>
          <a href={url("docs/architecture/")}>Architecture</a>
          <a href={url("docs/security/")}>Trust & security</a>
          <a href={url("docs/operations/")}>Operations</a>
        </div>
        <div class="footer-nav">
          <span class="eyebrow">Build with us</span>
          <a href="https://github.com/WeCoLabHQ/wecolab">Source code ↗</a>
          <a href="https://github.com/WeCoLabHQ/wecolab/issues">
            Issues & ideas ↗
          </a>
          <a href={url("contribute/")}>Contributing</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>Independent hardware. Shared possibilities.</span>
        <a href="https://github.com/WeCoLabHQ/wecolab/blob/main/LICENSE">
          Free software · AGPLv3
        </a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#main-navigation");
      const close = () => {
        toggle?.setAttribute("aria-expanded", "false");
        nav?.removeAttribute("data-open");
      };
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        nav?.toggleAttribute("data-open", open);
      });
      nav?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) close();
      });
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          close();
          toggle.focus();
        }
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          const search =
            document.querySelector<HTMLAnchorElement>(".nav-search");
          if (search) window.location.assign(search.href);
        }
      });
    </script>
    <noscript>
      <style>
        .menu-toggle {
          display: none !important;
        }
        .header-links {
          display: flex !important;
        }
      </style>
    </noscript>
  </body>
</html>
